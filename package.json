{
  "name": "konosuba-trpg-rulebook",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "python scripts/build_data.py",
    "desktop": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "cn.konosuba.trpg",
    "productName": "KonosubaTRPG-CN",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/img/**",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-win-x64.${ext}"
    },
    "portable": {
      "artifactName": "KonosubaTRPG-CN-${version}-portable.exe"
    }
  }
}